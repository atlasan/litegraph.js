{
    "name": "@litegraph/litegraph",
    "version": "0.10.10",
    "description": "A flow graph node editor on the web.",
    "main": "build_node/litegraph.cjs",
    "type": "module",
    "types": "src/litegraph.d.ts",
    "private": false,
    "scripts": {
        "build": "python3 build.py",
        "docs": "jsdoc -c ./docs/.jsdoc.config -d ./docs/api -r --verbose --debug",
        "editor": "nodemon editor.js",
        "graphrunner": "nodemon --exec node headless/graphrunner/server/index.js",
        "start": "concurrently \"npm run editor\" \"npm run graphrunner\"",
        "test": "node --experimental-vm-modules node_modules/jest-cli/bin/jest.js",
        "lint": "eslint src",
        "lint:fix": "eslint --fix src",
        "nodemon": "nodemon",
        "test:integration": "node --test tools/tests/*.test.mjs",
        "check:build": "node tools/check-build.mjs",
        "check": "npm run lint -- --quiet && npm run build && npm run check:types && npm test -- --runInBand && npm run test:integration && npm run check:build",
        "check:types": "node tools/check-types.mjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/atlasan/litegraph.js.git"
    },
    "author": "Various",
    "license": "MIT",
    "files": [
        "build",
        "build_node",
        "css/litegraph.css",
        "src/litegraph.d.ts",
        "src/litegraph.d.cts",
        "src/litegraph.core.d.ts",
        "src/litegraph.full.d.cts",
        "src/litegraph.node.d.cts"
    ],
    "bugs": {
        "url": "https://github.com/atlasan/litegraph.js/issues"
    },
    "homepage": "https://github.com/atlasan/litegraph.js#readme",
    "devDependencies": {
        "@stylistic/eslint-plugin": "^2.1.0",
        "@types/jest": "^28.1.3",
        "concurrently": "^7.6.0",
        "eslint": "^8.37.0",
        "eslint-plugin-jest": "^27.2.1",
        "express": "^4.21.2",
        "jest-cli": "^28.1.3",
        "js-beautify": "^1.15.1",
        "jsdoc": "^4.0.3",
        "jsdom": "^17.0.0",
        "nodemon": "^3.1.0",
        "typescript": "5.4.5",
        "uglify-js": "^3.0.0"
    },
    "keywords": [
        "flow",
        "graph",
        "node",
        "editor",
        "web",
        "js",
        "node.js",
        "visual programming",
        "visual scripting"
    ],
    "dependencies": {
        "chalk": "^5.4.1",
        "child_process": "^1.0.2",
        "diskusage": "^1.2.0",
        "dotenv": "^16.4.7",
        "fs": "^0.0.1-security",
        "http": "^0.0.1-security",
        "node-fetch": "^3.3.2",
        "node-os-utils": "^1.3.7",
        "node-windows": "^1.0.0-beta.8",
        "osc": "^2.4.4",
        "osc-js": "^2.4.1",
        "path": "^0.12.7",
        "ps-list": "^8.1.1",
        "socket.io": "^4.8.1",
        "socket.io-client": "^4.8.1",
        "uglifyjs": "^2.4.11",
        "vm": "^0.1.0",
        "winston": "^3.17.0",
        "ws": "^8.22.1"
    },
    "module": "build/litegraph.js",
    "exports": {
        ".": {
            "import": {
                "types": "./src/litegraph.d.ts",
                "default": "./build/litegraph.js"
            },
            "require": {
                "types": "./src/litegraph.full.d.cts",
                "default": "./build_node/litegraph.cjs"
            }
        },
        "./node": {
            "types": "./src/litegraph.node.d.cts",
            "default": "./build_node/litegraph_nodejs.full.cjs"
        },
        "./build/*": "./build/*",
        "./build_node/*": "./build_node/*",
        "./css/*": "./css/*",
        "./package.json": "./package.json",
        "./core": {
            "import": {
                "types": "./src/litegraph.core.d.ts",
                "default": "./build/litegraph.core.js"
            },
            "require": {
                "types": "./src/litegraph.d.cts",
                "default": "./build_node/litegraph.core.cjs"
            }
        }
    },
    "jest": {
        "testPathIgnorePatterns": [
            "/node_modules/",
            "<rootDir>/.claude/"
        ],
        "modulePathIgnorePatterns": [
            "<rootDir>/.claude/"
        ]
    },
    "overrides": {
        "osc": {
            "ws": "$ws"
        },
        "engine.io": "6.6.11",
        "engine.io-client": "6.6.7",
        "brace-expansion@^2": "2.1.7",
        "brace-expansion@^1": "1.1.21"
    }
}

      "profile": "mixed",
      "flow": "mixed",
      "tags": [
        "essentials",
        "boolean-toggle"
      ],
      "packs": [
        "basic",
        "interface"
      ],
      "level": "basic",
      "guide": {
        "steps": [
          "Press Play or Step to see the initial true value.",
          "Change the boolean widget, or click the Toggle button.",
          "Open node details to inspect the saved value."
        ],
        "expected": "The Watch value changes between true and false. Each button action inverts the stored boolean.",
        "settings": [
          "Const Boolean → value",
          "Optional input: toggle"
        ]
      }
    },

 "groups": [
  {
   "id": 1,
   "title": "Node modes say when a node runs; each box shows one mode with a Counter that counts its own executions (\"Count Exec.\"). The document runs under the \"ancestors\" execution model (the chip at the top left), the default for new documents: an action runs its target at once and first pulls the ON_REQUEST nodes it reads. Documents saved before 0.18 load as \"legacy\", where the same modes behave as in older LiteGraph; there, mode 4 is now BYPASS and 5 ON_REQUEST (older files are renumbered on load). Change a mode from the node menu or the node panel.",
   "bounding": [
    40,
    20,
    1000,
    92
   ],
   "color": "#3f789e",
   "font_size": 16
  },
  {
   "id": 2,
   "title": "ALWAYS: runs once per frame while the graph plays. Press Play: the count keeps rising.",
   "bounding": [
    40,
    180,
    340,
    196
   ],
   "color": "#8A8",
   "font_size": 15
  },
  {
   "id": 3,
   "title": "ON_EVENT: runs only when an action reaches it. Each click adds one, with or without Play.",
   "bounding": [
    410,
    180,
    340,
    196
   ],
   "color": "#A88",
   "font_size": 15
  },
  {
   "id": 4,
   "title": "ON_TRIGGER: runs once each time its onTrigger input fires; Play does not run it.",
   "bounding": [
    780,
    180,
    340,
    216
   ],
   "color": "#88A",
   "font_size": 15
  },
  {
   "id": 5,
   "title": "ON_REQUEST: runs only when a node needs its data. Each click on read makes the Watch pull it once.",
   "bounding": [
    40,
    455,
    340,
    309
   ],
   "color": "#AA8",
   "font_size": 15
  },
  {
   "id": 6,
   "title": "NEVER (muted): does not run; its events are dropped, so the count stays 0.",
   "bounding": [
    410,
    470,
    340,
    196
   ],
   "color": "#666",
   "font_size": 15
  },
  {
   "id": 7,
   "title": "BYPASS: the node is a wire; its first input passes through. Press Play: the Watch shows 5, not 15.",

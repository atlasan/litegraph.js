HOST=127.0.0.1
PORT=3000
# Absolute path, or relative to headless/graphrunner:
WORKFLOWS_DIR=workflows
LOG_LEVEL=info
# Extra host names (comma-separated, no port) accepted in Host/Origin besides loopback and HOST:
# RUNNER_ALLOWED_HOSTS=
# Node types that run commands, read or write files, open network servers or load remote code, and
# script nodes (math/formula, basic/script, objects/evaluate), are refused unless this is 1:
# RUNNER_ALLOW_SYS=0
# Or allow only some of the refused types (comma-separated; a trailing "/" allows a whole prefix):
# RUNNER_ALLOW_TYPES=sys/fileRead,nodejs/network/
# Extra node types to refuse (comma-separated; a trailing "/" refuses a whole prefix):
# RUNNER_DENY_TYPES=
